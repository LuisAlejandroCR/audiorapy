{
  "name": "audiorapy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project fuzz --project invariant",
    "test:unit": "vitest run --project unit",
    "test:fuzz": "vitest run --project fuzz",
    "test:invariant": "vitest run --project invariant",
    "build": "npm run typecheck && npm run build -w @audiorapy/web",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "dev:api": "npm run dev -w @audiorapy/api",
    "start:api": "npm run start -w @audiorapy/api",
    "smoke:api": "tsx scripts/smoke-api.ts",
    "test:e2e": "playwright test",
    "dev:web": "npm run dev -w @audiorapy/web",
    "eval:intent": "tsx scripts/eval-intent.ts",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
