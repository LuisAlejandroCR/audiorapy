# .env.example: variable names only. Copy to .env and fill locally; never commit .env.
# Channel (Meta WhatsApp Cloud API). Empty = console channel (messages are logged, not sent).
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
# Only overridden to simulate an unreachable Meta (npm run demo:degraded).
META_GRAPH_BASE_URL=https://graph.facebook.com
# AI intent classifier: ollama | rules
AI_INTENT_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_MS=8000
# Scheduling store. Empty = in memory (lost on restart). Postgres URL (Render Postgres in production;
# add ?sslmode=require for its external URL) = persistent;
# the schema is created at startup. Only the messaging plane is stored there, never clinical content.
DATABASE_URL=
# No-show risk: sidecar | heuristic | off. `sidecar` calls services/risk (TabPFN-2 or its logistic
# baseline) and falls back to the heuristic when it is down.
RISK_PROVIDER=heuristic
RISK_URL=http://127.0.0.1:8090
RISK_TIMEOUT_MS=3000
# Therapist dashboard API. Empty token = /api/* disabled (503).
DASHBOARD_TOKEN=
DASHBOARD_ORIGIN=http://localhost:5173
# Shown in the consent message.
PRACTICE_NAME=Fonoaudiología a domicilio
PRIVACY_URL=https://example.org/privacidad
PORT=3000
HOST=127.0.0.1
