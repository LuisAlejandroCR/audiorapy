# .env.example: variable names only. Copy to .env and fill locally; never commit .env.
# Channel (Meta WhatsApp Cloud API). Empty = console channel (messages are logged, not sent).
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
# AI intent classifier: ollama | rules
AI_INTENT_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
# No-show risk: heuristic | off
RISK_PROVIDER=heuristic
PORT=3000
